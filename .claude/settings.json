{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$CLAUDE_CODE_REMOTE\" = true ]; then \"$CLAUDE_PROJECT_DIR/.devcontainer/setup.sh\" cloud; fi",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
